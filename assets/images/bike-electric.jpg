<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The Ascent Electric Bicycle">
  <defs>
    <linearGradient id="sky-elec" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FBE9E9"/>
      <stop offset="100%" stop-color="#FAD2D2"/>
    </linearGradient>
    <filter id="shadow-e" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#E15B4B" flood-opacity="0.2"/>
    </filter>
  </defs>
  
  <!-- Background Card -->
  <rect width="800" height="500" rx="16" fill="url(#sky-elec)"/>
  
  <!-- Mountain Ridges Background -->
  <path d="M 0 360 L 180 230 L 320 290 L 500 180 L 680 280 L 800 210 L 800 500 L 0 500 Z" fill="#F4B4AC" opacity="0.4"/>
  <path d="M 0 360 L 250 280 L 450 330 L 700 260 L 800 300 L 800 500 L 0 500 Z" fill="#E8958A" opacity="0.5"/>
  
  <!-- Ground Line -->
  <path d="M 0 360 L 800 360" stroke="#E15B4B" stroke-width="4" stroke-dasharray="12 8"/>
  
  <!-- Bicycle Shadows -->
  <ellipse cx="240" cy="364" rx="110" ry="12" fill="#991B1B" opacity="0.18"/>
  <ellipse cx="560" cy="364" rx="110" ry="12" fill="#991B1B" opacity="0.18"/>
  
  <!-- FRONT WHEEL -->
  <g filter="url(#shadow-e)">
    <circle cx="560" cy="260" r="90" fill="none" stroke="#0F172A" stroke-width="16"/>
    <circle cx="560" cy="260" r="76" fill="none" stroke="#E2E8F0" stroke-width="4"/>
    <g stroke="#64748B" stroke-width="2">
      <line x1="560" y1="170" x2="560" y2="350"/>
      <line x1="470" y1="260" x2="650" y2="260"/>
      <line x1="496" y1="196" x2="624" y2="324"/>
      <line x1="496" y1="324" x2="624" y2="196"/>
    </g>
    <circle cx="560" cy="260" r="16" fill="#E15B4B"/>
  </g>  

  <!-- REAR WHEEL -->
  <g filter="url(#shadow-e)">
    <circle cx="240" cy="260" r="90" fill="none" stroke="#0F172A" stroke-width="16"/>
    <circle cx="240" cy="260" r="76" fill="none" stroke="#E2E8F0" stroke-width="4"/>
    <g stroke="#64748B" stroke-width="2">
      <line x1="240" y1="170" x2="240" y2="350"/>
      <line x1="150" y1="260" x2="330" y2="260"/>
      <line x1="176" y1="196" x2="304" y2="324"/>
      <line x1="176" y1="324" x2="304" y2="196"/>
    </g>
    <circle cx="240" cy="260" r="38" fill="#1E293B" stroke="#E15B4B" stroke-width="3"/>
    <path d="M 230 250 L 250 250 L 235 270 L 255 270" stroke="#E8A93B" stroke-width="3" fill="none"/>
  </g>

  <!-- ELECTRIC FRAME -->
  <g fill="none" stroke="#E15B4B" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" filter="url(#shadow-e)">
    <path d="M 240 260 L 350 140"/>
    <path d="M 240 260 L 370 260"/>
    <path d="M 350 140 L 370 260"/>
    <path d="M 350 140 L 515 150"/>
    <path d="M 370 260 L 515 150" stroke-width="22" stroke="#B91C1C"/>
    <path d="M 370 260 L 515 150" stroke-width="16" stroke="#E15B4B"/>
    <path d="M 560 260 L 515 150 L 500 90"/>
    <path d="M 480 90 L 530 90"/>
  </g>

  <!-- Battery Pack -->
  <rect x="400" y="180" width="80" height="14" rx="4" transform="rotate(-36 400 180)" fill="#1E293B"/>
  <circle cx="410" cy="205" r="4" fill="#22C55E"/>
  <circle cx="420" cy="198" r="4" fill="#22C55E"/>
  <circle cx="430" cy="191" r="4" fill="#22C55E"/>
  <circle cx="440" cy="184" r="4" fill="#E8A93B"/>

  <!-- Display & Headlight -->
  <rect x="495" y="75" width="18" height="14" rx="3" fill="#0F172A" stroke="#38BDF8" stroke-width="2"/>
  <circle cx="530" cy="140" r="12" fill="#FFFFFF" stroke="#E15B4B" stroke-width="3"/>
  <path d="M 530 140 L 570 120 L 570 160 Z" fill="#FEF08A" opacity="0.5"/>

  <!-- Saddle -->
  <path d="M 320 135 C 330 120, 375 120, 380 138 Z" fill="#0F172A"/>
  <rect x="345" y="140" width="10" height="20" fill="#64748B"/>

  <!-- Inset Pill Badge Overlay -->
  <g filter="url(#shadow-e)">
    <rect x="40" y="30" width="280" height="34" rx="17" fill="#E15B4B"/>
    <text x="180" y="52" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="700" letter-spacing="0.5" text-anchor="middle">PEDAL ASSIST E-BIKE ? 25 KM/H</text>
  </g>
</svg>