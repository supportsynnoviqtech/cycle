<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The Morning Loop Tour">
  <rect width="800" height="500" rx="16" fill="#EAF0FE"/>
  <path d="M 0 300 Q 200 240 400 290 T 800 270 L 800 500 L 0 500 Z" fill="#3B82F6" opacity="0.3"/>
  <path d="M 0 350 Q 250 310 500 360 T 800 330 L 800 500 L 0 500 Z" fill="#1F3F8C" opacity="0.7"/>
  <path d="M 50 480 Q 250 380 450 420 T 750 360" fill="none" stroke="#E8A93B" stroke-width="16" stroke-linecap="round"/>
  <path d="M 50 480 Q 250 380 450 420 T 750 360" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-dasharray="12 12"/>
  <circle cx="200" cy="405" r="18" fill="#E15B4B"/>
  <text x="200" y="411" fill="#FFF" font-weight="bold" text-anchor="middle" font-size="14">1</text>
  <circle cx="500" cy="410" r="18" fill="#E15B4B"/>
  <text x="500" y="416" fill="#FFF" font-weight="bold" text-anchor="middle" font-size="14">2</text>
  
  <!-- Inset Badge Overlay -->
  <rect x="40" y="30" width="270" height="34" rx="17" fill="#1F3F8C"/>
  <text x="175" y="52" fill="#FFFFFF" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="700" letter-spacing="0.5" text-anchor="middle">THE MORNING LOOP ? 12 KM</text>
</svg>